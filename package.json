{
  "name": "ui-test-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Beginner-friendly Playwright + TypeScript UI test framework using Page Object Model",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:headed": "node scripts/run-tests.js --headed",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate ./allure-results --output ./allure-report",
    "allure:open": "allure open ./allure-report/awesome"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "allure": "^3.0.0",
    "allure-playwright": "^3.4.1",
    "typescript": "^5.8.0"
  }
}
